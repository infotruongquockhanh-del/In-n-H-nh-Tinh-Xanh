rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function passwordAuth() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password';
    }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function ownerPath() { return /databases/$(database)/documents/config/directorOwner; }
    function hasUser() { return passwordAuth() && exists(userPath()); }
    function user() { return get(userPath()).data; }
    function active() {
      return hasUser() && user().active == true
        && user().role in ['director','accounting','sales','designer','printing'];
    }
    function director() { return active() && user().role == 'director'; }
    function office() { return active() && user().role in ['director','accounting','sales']; }
    function payroll() { return active() && user().role in ['director','accounting']; }
    function noDirectorOwner() { return !exists(ownerPath()); }

    match /loginIndex/{username} {
      allow get: if true;
      allow list: if false;
      allow create: if director()
        || (passwordAuth() && noDirectorOwner() && username == 'giamdoc'
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.authEmail == request.auth.token.email
          && request.resource.data.active == true);
      allow update, delete: if director();
    }

    match /users/{uid} {
      allow read: if director()
        || (passwordAuth() && request.auth.uid == uid && resource.data.active == true)
        || (passwordAuth() && request.auth.uid == uid && noDirectorOwner());
      allow create: if director()
        || (passwordAuth() && request.auth.uid == uid && noDirectorOwner()
          && request.resource.data.username == 'giamdoc'
          && request.resource.data.role == 'director'
          && request.resource.data.active == true
          && request.resource.data.authEmail == request.auth.token.email);
      allow update, delete: if director();
    }

    match /config/directorOwner {
      allow read: if passwordAuth();
      allow create: if passwordAuth() && noDirectorOwner()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == 'giamdoc';
      allow update, delete: if director();
    }

    match /orders/{id} {
      allow read: if active();
      allow create, delete: if office();
      allow update: if office()
        || (active() && user().role in ['designer','printing']
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status','designerId','designerName','designWork','version','updatedAt','updatedBy']));
    }
    match /customers/{id} {
      allow read: if active();
      allow create, update: if office();
      allow delete: if director();
    }
    match /inventory/{id} { allow read, create, update, delete: if office(); }
    match /customProducts/{id} { allow read, create, update, delete: if office(); }
    match /settings/{id} {
      allow read: if active() && (id != 'htx_payroll_v17' || payroll());
      allow write: if (id == 'htx_payroll_v17' && payroll())
        || (id in ['htx_work_month_v7','htx_price_adjustments_v6','htx_catalog_overrides_v7'] && office());
    }
    match /designCompletions/{id} {
      allow read: if payroll()
        || (active() && user().role == 'designer' && resource.data.employeeId == user().id);
      allow create, update: if payroll()
        || (active() && user().role == 'designer' && request.resource.data.employeeId == user().id);
      allow delete: if director();
    }
    match /config/designKpiPolicy {
      allow read: if payroll();
      allow write: if director();
    }
    match /config/{id} {
      allow read: if active();
      allow write: if director();
    }
    match /auditLogs/{id} {
      allow create: if active();
      allow read: if director();
      allow update, delete: if false;
    }
    match /dataHistory/{id} {
      allow create: if active();
      allow read: if director();
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
