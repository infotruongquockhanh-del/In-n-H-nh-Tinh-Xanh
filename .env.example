# Cloud Run / Google AI Studio: đặt biến này trong Secrets.
SESSION_SECRET=doi-thanh-chuoi-ngau-nhien-it-nhat-32-ky-tu

# Khi chạy LOCAL, chọn 1 trong 2 cách:
# Cách 1: GOOGLE_APPLICATION_CREDENTIALS trỏ tới service-account JSON.
# GOOGLE_APPLICATION_CREDENTIALS=/duong-dan/service-account.json

# Cách 2: dán nguyên JSON service account vào biến sau.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Có thể khai báo rõ project nếu môi trường không tự nhận.
# FIREBASE_PROJECT_ID=your-firebase-project-id

PORT=8080


# GOOGLE SHEET + APPS SCRIPT SYNC V23
GOOGLE_SHEETS_WEBAPP_URL=https://script.google.com/macros/s/THAY_ID_CUA_BAN/exec
GOOGLE_SHEETS_SYNC_SECRET=doi-thanh-secret-rat-dai-va-kho-doan


# ===== V25 FIREBASE WEB CONFIG CHO REALTIME CLIENT =====
# Các giá trị này lấy tại Firebase Console > Project settings > Your apps > Web app.
# Đây là Firebase Web Config (không phải service-account private key).
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=

# FIREBASE_PROJECT_ID đã dùng cho Firebase Admin và cũng dùng cho client.
